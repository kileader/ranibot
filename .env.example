# Required: keep real credentials in .env, never in source control.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
LLM_API_KEY=replace_with_openai_api_key

# v0 implements only the OpenAI provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Recommended for testing: enable Discord Developer Mode, then Copy Server ID.
# Set this to register /agents only in that server. Blank = global registration.
DISCORD_GUILD_ID=

# PostgreSQL connection string. Required only for persistent server memory.
# Railway supplies this through a reference to the attached Postgres service.
DATABASE_URL=
